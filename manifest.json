{
  "manifest_version": 3,
  "name": "RingAnime",
  "version": "0.4.1",
  "description": "Te avisa cuando un anime que sigues tiene nueva temporada.",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RingAnime",
    "default_icon": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["notifications", "storage", "alarms"],
  "host_permissions": ["https://*.anilist.co/*"]
}
